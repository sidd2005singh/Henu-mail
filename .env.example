# ====================================================================
# HENU MAIL - Environment Variable Configuration Template
# HENU OS PRIVATE LIMITED
# ====================================================================
# Copy this file to .env.local for development or configure in your production CI/CD.
# NEVER commit real secret keys, service role keys, or production credentials to git.

# --- Application Base ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Cluster & Database Access ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Cryptographic Security Key (AES-256-GCM) ---
# Generate a 32-byte secret (e.g., `openssl rand -hex 32`) for encrypting OAuth tokens at rest.
ENCRYPTION_SECRET=your_32_byte_hex_encryption_secret_here

# --- Google OAuth 2.0 Provider Credentials ---
# Obtained from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/providers/google/callback

# --- Microsoft Graph OAuth Credentials (Optional / Future) ---
MICROSOFT_CLIENT_ID=your-microsoft-app-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/providers/microsoft/callback

# --- Background Queue & Distributed Cache ---
REDIS_URL=redis://localhost:6379

# --- HENU SCRAPPER — Intelligence Engine & AI Provider Configuration ---
# Google Gemini API Key for zero-hallucination evidence reasoning
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# HENU OS Private Intelligence Gateway API
HENU_OS_API_ENDPOINT=https://api.henuos.com/v1/intelligence
HENU_OS_API_KEY=your_henu_os_api_key_here

# OpenRouter Fallback Multi-Model Gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Scrapper Concurrency & Security Limits
SCRAPPER_MAX_CONCURRENCY=5
SCRAPPER_RATE_LIMIT_PER_MIN=60
SCRAPPER_DEFAULT_CACHE_TTL_DAYS=30

# --- Monitoring & Observability ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOG_LEVEL=info

